# War — top-level environment template.
# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Snapser platform API key (deploying the validator BYOSnap; Snapser MCP / CLI auth).
SNAPSER_API_KEY=

# Shared secret the validator uses to verify gateway-stamped identity / internal callers.
# Locally there is no gateway, so the Hermes-emulation endpoint's ?token=<player-id> query
# param is the self-stamped player id and this secret is unused.
VALIDATOR_SHARED_SECRET=
