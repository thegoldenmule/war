# War validator — environment template. Copy to `.env` for local runs.
# The validator serves ONE codepath: the Snapser Hermes WebSocket envelope.

# --- HTTP / health ---
# Local dev binds :5555; the deployed BYOSnap container binds :8080.
# /health is served UNPREFIXED on this port (see Dockerfile HEALTHCHECK).
HTTP_PORT=5555

# --- gRPC ---
# war.validator.v1.ValidatorService { InitMatch, ValidateAction, CompleteMatch }
GRPC_PORT=8081

# --- Hermes WebSocket ---
# Local: ws://localhost:5555/hermes/ws?token=<player-id>
# The ?token= query param is the self-stamped player id (see auth model in README).
HERMES_WS_PATH=/hermes/ws

# --- MCP ---
# POST /mcp — debug/control surface mirroring the client WarDebug API.
MCP_PATH=/mcp

# --- Runtime ---
# development | production
NODE_ENV=development

# Authoritative protocol/state version. Must match WarConstants.VERSION
# on the GDScript side or the parity contract is violated.
STATE_VERSION=1

# Path to the Special Cards catalog consumed by the validator at boot.
CARD_CATALOG_PATH=./content/card_catalog.json
