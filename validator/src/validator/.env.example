# =============================================================================
# @war/validator environment
# Copy to `.env` and adjust. All values are read + validated by config.ts.
# =============================================================================

# HTTP port for the Hono app (health, /api/status, /mcp, /hermes/ws upgrade).
# Local default 5555; deployed the gateway maps it to 8080.
PORT=5555

# gRPC port for war.validator.v1.ValidatorService.
GRPC_PORT=8081

# Shared secret used to verify gateway-stamped identity headers in production.
# Leave EMPTY for local dev: the Hermes WS path then trusts the self-stamped
# ?token=<player-id> query param (see hermes-ws.ts / CLAUDE.md auth model).
VALIDATOR_SHARED_SECRET=
