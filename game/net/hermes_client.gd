class_name WarHermesClient
extends Node
##
## WarHermesClient — Snapser Hermes envelope transport over a WebSocket.
##
## Role in the stack
## -----------------
##   WarValidatorClient   (high-level: init_match / validate_action)
##        └── WarHermesClient   (this — envelope framing + socket lifecycle)
##                 └── WebSocketPeer   (raw frames)
##
## The validator is reached through Snapser's Hermes "snap-api-proxy": the
## client opens ONE persistent WebSocket and multiplexes request/response over
## it using the Hermes envelope protobufs
## (`protos/hermes/hermes_envelope.proto`):
##
##   ClientMessage  — what we send up   (wraps an inner api request + an id)
##   ServerMessage  — what comes back   (wraps an inner api response + the id)
##
## Locally the validator serves the IDENTICAL envelope at
##   ws://localhost:5555/hermes/ws?token=<player-id>
## so this class never branches on environment beyond the base URL + token.
##
## Determinism boundary
## --------------------
## Game state and actions ALWAYS travel as canonical-JSON STRINGS inside the
## proto string fields. We never re-model the hashed state as proto messages —
## the JSON string IS the hash domain. This class only frames bytes; it does
## not parse or hash game state.
##
## Skeleton scope
## --------------
## Connection lifecycle (`connect_to_validator` / `disconnect_from_validator`),
## the poll pump, and `send_envelope` / request correlation are real and
## working at the framing level. The protobuf (de)serialization is stubbed
## behind `# TODO(skeleton)` because the godobuf bindings live in
## `net/proto/*_pb.gd` and are generated by `tools/gen-protos.sh`. Until those
## land we frame a debug JSON envelope so the lifecycle is exercisable headless.
##

## Socket opened and the Hermes handshake (if any) completed; ready to send.
signal connected()
## Socket closed, either intentionally or by error. `clean` distinguishes.
signal disconnected(clean: bool)
## A correlated reply arrived for a previously-sent request.
## `payload` is the decoded inner api response (a Dictionary for the skeleton
## JSON path; a proto message once godobuf is wired).
signal envelope_received(request_id: String, payload: Variant)
## Any transport-level failure (connect refused, decode error, timeout).
signal transport_error(reason: String)

## Connection states for a small explicit FSM; mirrors WebSocketPeer states
## plus our own pre-connect/closed bookkeeping.
enum State { CLOSED, CONNECTING, OPEN, CLOSING }

## Local validator Hermes endpoint. `{token}` is filled with the player id.
const LOCAL_HERMES_URL := "ws://localhost:5555/hermes/ws"
## Production endpoint is the Snapser gateway; injected per deployment.
const PROD_HERMES_URL := "wss://gateway.snapser.example/hermes/ws"

## How long (seconds) a pending request waits before we surface a timeout.
const REQUEST_TIMEOUT_SEC := 10.0

@export var base_url: String = LOCAL_HERMES_URL

var _socket: WebSocketPeer = null
var _state: State = State.CLOSED
## The token (player id locally) appended as `?token=`. Set by `configure`.
var _token: String = ""
## Monotonic counter feeding request-id generation.
var _next_seq: int = 0
## request_id -> { "sent_at": float } so we can time out / correlate replies.
var _pending: Dictionary = {}


func _ready() -> void:
	# We pump the socket ourselves each frame; no auto-processing otherwise.
	set_process(false)


## Set the identity/token used for the connection URL. Call before connecting.
## `token` is the value from WarSnapserAuth.get_token().
func configure(token: String) -> void:
	_token = token


## Open the WebSocket to the validator. Safe to call once; re-calling while
## already connecting/open is a no-op. Resolution arrives via `connected` /
## `transport_error`.
func connect_to_validator() -> void:
	if _state == State.OPEN or _state == State.CONNECTING:
		return
	_socket = WebSocketPeer.new()
	var url := _build_url()
	var err := _socket.connect_to_url(url)
	if err != OK:
		_state = State.CLOSED
		transport_error.emit("connect_to_url failed: %s" % error_string(err))
		return
	_state = State.CONNECTING
	set_process(true)


## Gracefully close the socket. `disconnected(true)` follows once flushed.
func disconnect_from_validator() -> void:
	if _socket == null or _state == State.CLOSED:
		return
	_state = State.CLOSING
	_socket.close()


## True only when the socket is open and ready to carry envelopes.
func is_open() -> bool:
	return _state == State.OPEN


## Send an inner api request wrapped in a Hermes ClientMessage envelope.
##
## `api_method` names the validator RPC ("InitMatch"|"ValidateAction"|
## "CompleteMatch"); `body` is a Dictionary whose values are already
## canonical-JSON STRINGS where the contract requires it (state/action). A
## fresh request id is generated, recorded in `_pending`, and returned so the
## caller can correlate the eventual `envelope_received`.
##
## Returns "" if the socket is not open (caller should retry after `connected`).
func send_envelope(api_method: String, body: Dictionary) -> String:
	if not is_open():
		transport_error.emit("send while socket not open")
		return ""
	var request_id := _make_request_id()
	var bytes := _encode_client_message(request_id, api_method, body)
	var err := _socket.put_packet(bytes)
	if err != OK:
		transport_error.emit("put_packet failed: %s" % error_string(err))
		return ""
	_pending[request_id] = {"sent_at": Time.get_unix_time_from_system()}
	return request_id


## Per-frame pump: advance the socket, surface state transitions, drain inbound
## packets, and expire timed-out requests. Driven by `set_process`.
func _process(_delta: float) -> void:
	if _socket == null:
		set_process(false)
		return
	_socket.poll()
	var ws_state := _socket.get_ready_state()
	match ws_state:
		WebSocketPeer.STATE_OPEN:
			if _state == State.CONNECTING:
				_state = State.OPEN
				connected.emit()
			_drain_inbound()
		WebSocketPeer.STATE_CLOSING:
			pass
		WebSocketPeer.STATE_CLOSED:
			var clean := _state == State.CLOSING
			_teardown(clean)
			return
	_expire_pending()


## Read and dispatch every fully-received packet currently buffered.
func _drain_inbound() -> void:
	while _socket.get_available_packet_count() > 0:
		var pkt := _socket.get_packet()
		var decoded := _decode_server_message(pkt)
		if decoded.is_empty():
			continue
		var request_id: String = decoded.get("request_id", "")
		var payload: Variant = decoded.get("payload", null)
		if not request_id.is_empty():
			_pending.erase(request_id)
		envelope_received.emit(request_id, payload)


## Fail any request that has outlived REQUEST_TIMEOUT_SEC.
func _expire_pending() -> void:
	if _pending.is_empty():
		return
	var now := Time.get_unix_time_from_system()
	for request_id in _pending.keys():
		var sent_at: float = _pending[request_id].get("sent_at", now)
		if now - sent_at >= REQUEST_TIMEOUT_SEC:
			_pending.erase(request_id)
			transport_error.emit("request timed out: %s" % request_id)


## Reset to CLOSED and announce. Called on any socket close.
func _teardown(clean: bool) -> void:
	_state = State.CLOSED
	set_process(false)
	_socket = null
	_pending.clear()
	disconnected.emit(clean)


## Compose the connection URL with the `?token=` query param.
func _build_url() -> String:
	var token := _token if not _token.is_empty() else "anonymous"
	return "%s?token=%s" % [base_url, token.uri_encode()]


## Monotonic, connection-unique request id ("req-<n>").
func _make_request_id() -> String:
	_next_seq += 1
	return "req-%d" % _next_seq


## Encode a Hermes ClientMessage carrying an inner api request.
##
## Production: build the godobuf message and call `.to_bytes()`.
## Skeleton:   frame a JSON envelope so the lifecycle is exercisable now. The
##             JSON shape mirrors the proto fields one-for-one so swapping in
##             godobuf is a drop-in.
func _encode_client_message(request_id: String, api_method: String, body: Dictionary) -> PackedByteArray:
	# TODO(skeleton): replace with godobuf encode, e.g.
	#   var msg := HermesEnvelopePb.ClientMessage.new()
	#   msg.set_request_id(request_id)
	#   msg.set_api_method(api_method)        # snap-api-proxy method routing
	#   msg.set_payload_json(JSON.stringify(body))  # body values already canonical
	#   return msg.to_bytes()
	var envelope := {
		"request_id": request_id,
		"api_method": api_method,
		"body": body,
	}
	return JSON.stringify(envelope).to_utf8_buffer()


## Decode a Hermes ServerMessage into {request_id, payload}.
##
## Production: parse with godobuf, pull out the inner api response.
## Skeleton:   parse the JSON mirror produced by `_encode_client_message`'s
##             counterpart on the validator. Returns {} on malformed input.
func _decode_server_message(bytes: PackedByteArray) -> Dictionary:
	# TODO(skeleton): replace with godobuf decode, e.g.
	#   var msg := HermesEnvelopePb.ServerMessage.new()
	#   if msg.from_bytes(bytes) != HermesEnvelopePb.PB_ERR.NO_ERRORS: return {}
	#   return { "request_id": msg.get_request_id(),
	#            "payload": JSON.parse_string(msg.get_payload_json()) }
	var text := bytes.get_string_from_utf8()
	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		transport_error.emit("malformed server message")
		return {}
	return {
		"request_id": parsed.get("request_id", ""),
		"payload": parsed.get("body", null),
	}
